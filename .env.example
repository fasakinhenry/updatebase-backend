# ---------------------------------------------------------------------------
# updatebase api
# copy to .env and fill in. every var is validated at boot by src/config/env.ts,
# so a missing or malformed value stops the process with a readable message
# instead of failing somewhere deep in a request.
#
# everything listed here has a free tier. nothing needs a card on file.
# ---------------------------------------------------------------------------

NODE_ENV=development
PORT=4000
LOG_LEVEL=debug

# --- database: mongodb atlas M0 is free forever ---
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/updatebase

# --- urls ---
# comma separated if you need more than one origin
CLIENT_URL=http://localhost:5173
API_URL=http://localhost:4000

# --- auth ---
# generate each with: openssl rand -base64 48
JWT_ACCESS_SECRET=replace-with-a-long-random-string-at-least-32-chars
JWT_REFRESH_SECRET=replace-with-a-different-long-random-string-32-chars
COOKIE_SECRET=replace-with-another-random-string
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL_DAYS=30
# leave empty in development, set to your apex domain in production
COOKIE_DOMAIN=

# google oauth, from console.cloud.google.com -> credentials -> oauth client id
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- ai ---
# gemini is the default because its free tier needs no billing account.
# get a key at aistudio.google.com/apikey
# switch providers by changing these two lines and nothing else.
AI_PROVIDER=gemini
AI_MODEL=gemini-2.0-flash
GEMINI_API_KEY=

# only needed if you set AI_PROVIDER to one of these
# openai: AI_MODEL=gpt-4o-mini
OPENAI_API_KEY=
# anthropic: AI_MODEL=claude-sonnet-5
ANTHROPIC_API_KEY=

AI_TIMEOUT_MS=45000

# --- media: cloudinary free tier is 25gb ---
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# --- email: resend free tier is 3000 a month ---
RESEND_API_KEY=
MAIL_FROM=updatebase <hello@updatebase.app>

# --- money ---
# sandbox simulates wallets so nothing real moves while you build.
# switch to paystack when you are ready to take actual payments.
PAYMENTS_PROVIDER=sandbox
PAYSTACK_SECRET_KEY=
PAYSTACK_PUBLIC_KEY=
# what updatebase keeps from each tip, as a percentage
PLATFORM_FEE_PERCENT=5
